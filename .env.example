GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Postgres com a extensão pgvector habilitada. Em Render, Railway, Neon ou
# Supabase esta variável já vem pronta e é só colar.
#
# ATENÇÃO À PORTA. Nesta máquina a 5432 é de um container de trabalho, e este
# projeto NÃO deve usá-la. A porta definitiva ainda vai ser escolhida; até lá
# as duas variáveis abaixo estão em branco de propósito, e nem a app nem os
# testes rodam sem elas. Isso é a trava, não um esquecimento: a suíte trunca
# tabelas a cada caso, e um padrão conveniente apagaria o banco errado.
DATABASE_URL=

# Banco usado pela suíte de testes. Precisa ser diferente do de cima: os
# testes esvaziam as tabelas a cada caso.
DATABASE_URL_TEST=

# Senha do Postgres quando o banco sobe pelo docker-compose.
POSTGRES_PASSWORD=troque_esta_senha

# Quantos segundos reais valem um dia de prazo de entrega (entrega mockada).
# 20 deixa um pedido de prazo 4 chegar em ~80s, bom pra demo; 86400 simula
# tempo real.
SEGUNDOS_POR_DIA_ENTREGA=20

# O simulador (a tela do WhatsApp em static/) e o endpoint que reivindica um
# número. Ligado em 1 pro uso local, que é pra isso que ele existe. Publicado
# fica em 0: qualquer pessoa digitaria qualquer número e leria a conversa
# daquele cliente. O Dockerfile já força 0.
SIMULADOR=1
